                            <ByValueCondition>
                                <StoryboardElementStateCondition storyboardElementType="act" storyboardElementRef="Act1" state="completeState"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger name="Act4_stoptrigger">
                    <ConditionGroup>
                        <Condition name="Actor_Speed" conditionEdge="none" delay="0">
                            <ByEntityCondition>
                                <TriggeringEntities triggeringEntitiesRule="any">
                                    <EntityRef entityRef="ego"/>
                                </TriggeringEntities>
                                <EntityCondition>
                                    <SpeedCondition value="0" rule="equalTo"/>
                                </EntityCondition>
                            </ByEntityCondition>
                        </Condition>
                        <Condition name="Distance_to_Actor" delay="0" conditionEdge="none">
                            <ByEntityCondition>
                                <TriggeringEntities triggeringEntitiesRule="any">
                                    <EntityRef entityRef="ego"/>
                                </TriggeringEntities>
                                <EntityCondition>
                                    <RelativeDistanceCondition value="10" rule="greaterOrEqual" freespace="true" coordinateSystem="entity" relativeDistanceType="euclidianDistance" entityRef="adult1"/>
                                </EntityCondition>
                            </ByEntityCondition>
                        </Condition>
                    </ConditionGroup>
                </StopTrigger>
            </Act>
        </Story>
        <StopTrigger name="RootStory_stoptrigger">
            <ConditionGroup>
                <Condition name="" conditionEdge="none" delay="0">
                    <ByValueCondition>
                        <SimulationTimeCondition value="180" rule="greaterThan"/>
                    </ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>