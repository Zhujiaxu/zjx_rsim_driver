                                        <Property name="ParticleSpawnCount" value="20000"/>
                                        <Property name="DropScale" value="1.2"/>
                                    </Properties>
                                </Snow>
                                <Fog>
                                    <Properties>
                                        <Property name="Density" value="0.5"/>
                                        <Property name="Distance" value="1000"/>
                                        <Property name="Falloff" value="0.5"/>
                                    </Properties>
                                </Fog>
                                <Dust>
                                    <Properties>
                                        <Property name="Density" value="0.5"/>
                                        <Property name="DropDensity" value="0.5"/>
                                        <Property name="DropParticle" value="20000"/>
                                    </Properties>
                                </Dust>
                                <Wind>
                                    <Properties>
                                        <Property name="Intensity" value="0"/>
                                        <Property name="Direction" value="0"/>
                                    </Properties>
                                </Wind>
                                <Thunder>
                                    <Properties>
                                        <Property name="Lightning" value="0.5"/>
                                        <Property name="Interval" value="10"/>
                                        <Property name="Brightness" value="0.5"/>
                                    </Properties>
                                </Thunder>
                                <SimulateReality>
                                    <Properties>
                                        <Property name="LocationPreset" value="Beijing"/>
                                        <Property name="EnableSimulateReality" value="false"/>
                                        <Property name="Latitude" value="39.9"/>
                                        <Property name="Longitude" value="35.93"/>
                                        <Property name="TimeZone" value="2"/>
                                        <Property name="Date" value="2025-01-26"/>
                                    </Properties>
                                </SimulateReality>
                            </Weather>
                        </Environment>
                    </RsimEnvironmentAction>
                </GlobalAction>
                <GlobalAction>
                    <InfrastructureAction>
                        <TrafficSignalAction>
                            <TrafficSignalControllerAction phase="go" trafficSignalControllerRef="ctrl1"/>
                        </TrafficSignalAction>
                    </InfrastructureAction>
                </GlobalAction>
                <GlobalAction>
                    <InfrastructureAction>
                        <TrafficSignalAction>
                            <TrafficSignalControllerAction phase="stop" trafficSignalControllerRef="ctrl2"/>
                        </TrafficSignalAction>
                    </InfrastructureAction>
