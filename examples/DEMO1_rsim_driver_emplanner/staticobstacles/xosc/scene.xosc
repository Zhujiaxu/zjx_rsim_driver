                                    <Condition name="EnclosingActRunning" conditionEdge="none" delay="0.0000000000000000e+00">
                                        <ByValueCondition>
                                            <StoryboardElementStateCondition storyboardElementType="act" storyboardElementRef="Act2" state="runningState"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <ManeuverGroup name="GlobalGroup2" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false"/>
                    <Maneuver name="GlobalGroup2_Maneuver">
                        <Event name="ForceActToExecuteUntilStopTrigger" priority="parallel">
                            <Action name="NeverExecutedAction">
                                <UserDefinedAction>
                                    <CustomCommandAction type="MW_WaitAction"></CustomCommandAction>
                                </UserDefinedAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="NeverSatisfiedCondition" conditionEdge="none" delay="0.0000000000000000e+00">
                                        <ByValueCondition>
                                            <StoryboardElementStateCondition storyboardElementType="story" storyboardElementRef="RootStory" state="completeState"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="" conditionEdge="none" delay="0.0000000000000000e+00">
                            <ByValueCondition>
                                <SimulationTimeCondition value="0" rule="greaterThan"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger name="Act2_stoptrigger">
                    <ConditionGroup>
                        <Condition name="Distance_to_Point2" conditionEdge="none" delay="0">
                            <ByEntityCondition>
                                <TriggeringEntities triggeringEntitiesRule="any">
                                    <EntityRef entityRef="ego"/>
                                </TriggeringEntities>
                                <EntityCondition>
                                    <DistanceCondition value="8" rule="lessOrEqual" freespace="true" coordinateSystem="entity" relativeDistanceType="euclidianDistance">
                                        <Position>
                                            <WorldPosition x="-33.33012709095925" y="1.1592801345147947" z="0" h="0" p="0" r="0"/>
                                        </Position>
                                    </DistanceCondition>
                                </EntityCondition>
                            </ByEntityCondition>
                        </Condition>
                    </ConditionGroup>
                </StopTrigger>
            </Act>
            <Act name="Act3">
                <ManeuverGroup name="Act3_ManeuverGroup1" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="autoware1"/>
                    </Actors>
                    <Maneuver name="Act3_ManeuverGroup1_Maneuver1">
                        <Event maximumExecutionCount="1" name="Act3_ManeuverGroup1_Maneuver1_Event1" priority="parallel">
                            <Action name="Act3_ManeuverGroup1_Maneuver1_Event1_changespeed">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" dynamicsDimension="rate" value="1"/>
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="2"/>
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="" conditionEdge="none" delay="0.0000000000000000e+00">
                                        <ByValueCondition>
                                            <StoryboardElementStateCondition storyboardElementType="act" storyboardElementRef="Act3" state="runningState"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="" conditionEdge="none" delay="0.0000000000000000e+00">
                            <ByValueCondition>
                                <StoryboardElementStateCondition storyboardElementType="act" storyboardElementRef="Act1" state="completeState"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger name="Act3_stoptrigger">
                </StopTrigger>
            </Act>
            <Act name="Act4">
                <ManeuverGroup name="Act4_ManeuverGroup1" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="pedestrian_adult1"/>
                    </Actors>
                    <Maneuver name="Act4_ManeuverGroup1_Maneuver1">
                        <Event maximumExecutionCount="1" name="Act4_ManeuverGroup1_Maneuver1_Event1" priority="parallel">
                            <Action name="Act4_ManeuverGroup1_Maneuver1_Event1_changespeed">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" dynamicsDimension="rate" value="1"/>
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="3.5"/>
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="" conditionEdge="none" delay="0.0000000000000000e+00">
                                        <ByValueCondition>
                                            <StoryboardElementStateCondition storyboardElementType="act" storyboardElementRef="Act4" state="runningState"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="" conditionEdge="none" delay="0.0000000000000000e+00">
                            <ByValueCondition>
                                <StoryboardElementStateCondition storyboardElementType="act" storyboardElementRef="Act2" state="completeState"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger name="Act4_stoptrigger">
                </StopTrigger>
            </Act>
        </Story>
        <StopTrigger name="RootStory_stoptrigger">
            <ConditionGroup>
                <Condition name="" conditionEdge="none" delay="0">
                    <ByValueCondition>
                        <SimulationTimeCondition value="120" rule="greaterThan"/>
                    </ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>