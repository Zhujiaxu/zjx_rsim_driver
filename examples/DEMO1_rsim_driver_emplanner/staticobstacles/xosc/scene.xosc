                        </TrafficSignalAction>
                    </InfrastructureAction>
                </GlobalAction>
            </Actions>
        </Init>
        <Story name="RootStory">
            <Act name="Act0">
                <ManeuverGroup name="act0_group" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="ego"/>
                    </Actors>
                    <Maneuver name="act0_group_maneuver0">
                        <Event name="act0_group_maneuver0_evt0" priority="parallel">
                            <Action name="set_ego_route_action">
                                <UserDefinedAction>
                                    <CustomCommandAction type="SetEgoRoute">
                                        <Route name="ego_route" closed="false">
                                            <Waypoint routeStrategy="shortest">
                                                <Position>
                                                    <WorldPosition h="5.54079532623291" p="0" r="0" x="-130.13058118309402" y="-14.23665093492498" z="0"/>
                                                </Position>
                                            </Waypoint>
                                            <Waypoint routeStrategy="shortest">
                                                <Position>
                                                    <WorldPosition h="6.255133152008057" p="-0.0053644138388335705" r="0" x="142.7535241327124" y="-8.43435370141093" z="-0.044697168115967356"/>
                                                </Position>
                                            </Waypoint>
                                        </Route>
                                    </CustomCommandAction>
                                </UserDefinedAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="aa" delay="0" conditionEdge="none">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="0" rule="greaterOrEqual"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="act_start" delay="0" conditionEdge="none">
                            <ByValueCondition>
                                <SimulationTimeCondition value="0" rule="greaterOrEqual"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger/>
            </Act>
            <Act name="Act1">
                <ManeuverGroup name="GlobalGroup" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false"/>
                    <Maneuver name="GlobalGroup_Maneuver">
                        <Event name="GlobalGroup_Event" priority="parallel">
                            <Action name="GlobalGroup_Wait">
                                <UserDefinedAction>
                                    <CustomCommandAction type="MW_WaitAction"></CustomCommandAction>
                                </UserDefinedAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="EnclosingActRunning" conditionEdge="none" delay="0.0000000000000000e+00">
                                        <ByValueCondition>
                                            <StoryboardElementStateCondition storyboardElementType="act" storyboardElementRef="Act1" state="runningState"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <ManeuverGroup name="GlobalGroup2" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false"/>
                    <Maneuver name="GlobalGroup2_Maneuver">
                        <Event name="ForceActToExecuteUntilStopTrigger" priority="parallel">
                            <Action name="NeverExecutedAction">
                                <UserDefinedAction>
                                    <CustomCommandAction type="MW_WaitAction"></CustomCommandAction>
                                </UserDefinedAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="NeverSatisfiedCondition" conditionEdge="none" delay="0.0000000000000000e+00">
                                        <ByValueCondition>
                                            <StoryboardElementStateCondition storyboardElementType="story" storyboardElementRef="RootStory" state="completeState"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="" conditionEdge="none" delay="0.0000000000000000e+00">
                            <ByValueCondition>
                                <SimulationTimeCondition value="0" rule="greaterThan"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger name="Act1_stoptrigger">
                    <ConditionGroup>
                        <Condition name="Distance_to_Point" conditionEdge="none" delay="0">
                            <ByEntityCondition>
                                <TriggeringEntities triggeringEntitiesRule="any">
                                    <EntityRef entityRef="ego"/>
                                </TriggeringEntities>
                                <EntityCondition>
                                    <DistanceCondition value="5" rule="lessOrEqual" freespace="true" coordinateSystem="entity" relativeDistanceType="euclidianDistance">
                                        <Position>
                                            <WorldPosition x="7.426245337075869" y="2.099712789554551" z="-7.105427357601002e-15" h="0" p="0" r="0"/>
                                        </Position>
                                    </DistanceCondition>
                                </EntityCondition>
                            </ByEntityCondition>
                        </Condition>
                    </ConditionGroup>
                </StopTrigger>
            </Act>
            <Act name="Act2">
                <ManeuverGroup name="GlobalGroup" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false"/>
