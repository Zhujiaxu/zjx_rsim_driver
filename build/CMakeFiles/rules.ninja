#############################################
# Rule for linking CXX shared library.

rule CXX_SHARED_LIBRARY_LINKER__default_driver_Debug
  command = $PRE_LINK && /usr/local/bin/g++ -fPIC $LANGUAGE_COMPILE_FLAGS $ARCH_FLAGS $LINK_FLAGS -shared $SONAME_FLAG$SONAME -o $TARGET_FILE $in $LINK_PATH $LINK_LIBRARIES && $POST_BUILD
  description = Linking CXX shared library $TARGET_FILE
  restat = $RESTAT


